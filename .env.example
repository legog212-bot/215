# Supabase (project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, never exposed to the client

# Public site origin (used inside WhatsApp manage-links)
NEXT_PUBLIC_SITE_URL=https://salon215.ge

# Admin panel login — manager types one password; bcrypt hash checked server-side.
# Generate: npx bcryptjs or any bcrypt tool (cost 12).
ADMIN_PANEL_PASSWORD_HASH=
# Secret used to sign the admin session cookie. Optional — falls back to
# ADMIN_PANEL_PASSWORD_HASH. Set a long random string for extra isolation.
ADMIN_SESSION_SECRET=
# Internal Supabase Auth user (admin@salon215.local) — any long random string,
# used by the login route to create the real session. Never typed by humans.
ADMIN_AUTH_PASSWORD=

# WhatsApp Cloud API (Meta Business). Leave empty = notifications skipped.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_MANAGER_TEMPLATE_NAME=booking_confirmation
MANAGER_WHATSAPP_NUMBER=            # E.164, e.g. +995555123456
